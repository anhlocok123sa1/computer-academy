# ==============================================================================
# CẤU HÌNH NGINX VIRTUAL HOST CHO COMPUTER ACADEMY (LARAVEL + INERTIA.JS)
# Đường dẫn trên Ubuntu: /etc/nginx/sites-available/computer-academy.conf
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com; # Thay bằng tên miền hoặc IP của bạn

    # Thư mục gốc bắt buộc trỏ vào thư mục /public của Laravel
    root /var/www/computer-academy/public;
    index index.php index.html;

    charset utf-8;

    # Cấu hình giới hạn dung lượng tải lên (cho video, ảnh và tài liệu lớn)
    client_max_body_size 100M;

    # Gzip Compression tối ưu tốc độ tải trang
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Xử lý PHP thông qua PHP 8.3 FPM Socket
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Chặn truy cập trực tiếp vào các file ẩn (ví dụ: .env, .git)
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
